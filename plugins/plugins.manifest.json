{
  "schema": "extplugins/1",
  "apiVersion": "1.0.0",
  "policy": {
    "denyPermissions": [],
    "strictClaims": false
  },
  "plugins": [
    {
      "id": "hello",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.panel",
        "ui.command",
        "sim.observe",
        "sim.control"
      ],
      "claims": {
        "commands": [
          "ext.hello.poke"
        ],
        "panels": [
          "right.sidebar"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-panel",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.panel"
      ],
      "claims": {
        "panels": [
          "right.sidebar"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-command",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.command"
      ],
      "claims": {
        "commands": [
          "ext.command.ping"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-event",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "sim.observe"
      ],
      "claims": {},
      "enabled": true
    },
    {
      "id": "ext-element",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.menu",
        "element.register"
      ],
      "claims": {
        "elements": [
          "ExtShuntElm"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-hook",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "document.hook",
        "ui.command",
        "sim.control"
      ],
      "claims": {
        "commands": [
          "ext-hook.about"
        ],
        "hooks": [
          "load",
          "save"
        ]
      },
      "enabled": true
    }
  ]
}
