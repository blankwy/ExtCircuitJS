{
  "schema": "extplugins/1",
  "apiVersion": "1.0.0",
  "policy": {
    "denyPermissions": [],
    "strictClaims": false
  },
  "plugins": [
    {
      "id": "hello",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.panel",
        "ui.command",
        "sim.observe",
        "sim.control"
      ],
      "claims": {
        "commands": [
          "ext.hello.poke"
        ],
        "panels": [
          "right.sidebar"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-panel",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.panel"
      ],
      "claims": {
        "panels": [
          "right.sidebar"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-command",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.command"
      ],
      "claims": {
        "commands": [
          "ext.command.ping"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-event",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "sim.observe"
      ],
      "claims": {},
      "enabled": true
    },
    {
      "id": "ext-element",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "ui.menu",
        "element.register"
      ],
      "claims": {
        "elements": [
          "ExtShuntElm"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-hook",
      "entry": "index.js",
      "version": "0.1.0",
      "mode": "in-page",
      "permissions": [
        "document.hook",
        "ui.command",
        "sim.control"
      ],
      "claims": {
        "commands": [
          "ext-hook.about"
        ],
        "hooks": [
          "load",
          "save"
        ]
      },
      "enabled": true
    },
    {
      "id": "ext-worker",
      "name": "Ext Worker Demo",
      "version": "0.1.0",
      "apiVersion": "1.0.0",
      "entry": "worker.js",
      "mode": "worker",
      "workerType": "classic",
      "enabled": false,
      "permissions": [
        "sim.observe",
        "sim.control"
      ],
      "claims": {},
      "description": "Worker 模式示例"
    },
    {
      "id": "ext-theme",
      "name": "UI 外观（深色/浅色）",
      "version": "0.1.0",
      "apiVersion": "1.0.0",
      "entry": "index.js",
      "mode": "in-page",
      "enabled": true,
      "permissions": [],
      "claims": {},
      "description": "选项菜单加 UI 外观项，切换深色/浅色（画布联动，localStorage 记忆）"
    },
    {
      "id": "ext-neumorph",
      "name": "新拟态 UI",
      "version": "0.1.0",
      "apiVersion": "1.0.0",
      "entry": "index.js",
      "mode": "in-page",
      "enabled": true,
      "permissions": [
        "sim.observe"
      ],
      "claims": {},
      "description": "新拟态风格美化（软阴影/圆角/同色浮雕），只改样式不动布局，选项菜单可开关"
    },
    {
      "id": "ext-share",
      "name": "电路分享（URL / 单 HTML）",
      "version": "0.1.0",
      "apiVersion": "1.0.0",
      "entry": "index.js",
      "mode": "in-page",
      "enabled": true,
      "permissions": [
        "ui.command"
      ],
      "claims": {
        "commands": [
          "ext-share.url",
          "ext-share.copy",
          "ext-share.html"
        ]
      },
      "description": "把当前电路打包成分享链接（?ctz= 压缩）或分享页 HTML"
    },
    {
      "id": "ext-ai",
      "name": "AI 接入（MCP / Skill）",
      "version": "0.1.0",
      "apiVersion": "1.0.0",
      "entry": "index.js",
      "mode": "in-page",
      "enabled": true,
      "permissions": [
        "ui.command"
      ],
      "claims": {
        "commands": [
          "ext-ai.mcp",
          "ext-ai.skill"
        ]
      },
      "description": "顶部菜单加 AI：MCP 配置向导 + Skill 安装说明"
    }
  ]
}
